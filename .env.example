APP_ENV=local

# setlist.fm — get a free non-commercial key from your setlist.fm account settings.
SETLISTFM_API_KEY=
SETLISTFM_MODE=fixture        # fixture | live
SETLISTFM_MIN_INTERVAL_MS=1000
SETLISTFM_DAILY_BUDGET=1000   # stop for the day after this many requests

# iTunes Search API — no key needed.
ITUNES_MODE=fixture           # fixture | live
ITUNES_COUNTRY=us
ITUNES_MIN_INTERVAL_MS=3000    # Apple allows roughly 20 searches a minute

SETLIST_CACHE_TTL_HOURS=24
